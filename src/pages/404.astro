---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Pill from '../components/ui/Pill.astro';
import { ANCHORS } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t.notFound.seoTitle} description={t.notFound.seoDescription} noindex>
  <section class="nf">
    <div class="container container--wide">
      <Pill>{t.notFound.eyebrow}</Pill>
      <h1 class="nf__title">{t.notFound.title}</h1>
      <p class="nf__body">{t.notFound.body}</p>

      <div class="nf__actions">
        <Button href="/" size="lg">{t.notFound.home}</Button>
        <Button href={`/#${ANCHORS.proyectos}`} variant="outline" size="lg" icon="arrowRight">
          {t.hero.ctaProjects}
        </Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    align-content: center;
    min-height: calc(100dvh - var(--header-h));
    padding-block: var(--section-y);
  }

  .nf__title {
    max-width: 14ch;
    margin-top: 1.1rem;
    font-size: var(--t-display);
    font-weight: 250;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .nf__body {
    max-width: 54ch;
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    font-size: var(--t-lead);
    color: var(--ink-soft);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }
</style>

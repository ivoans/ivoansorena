---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  download?: boolean;
  external?: boolean;
  class?: string;
  hidden?: boolean;
  'aria-label'?: string;
}

const {
  href,
  variant = 'solid',
  size = 'md',
  icon,
  iconPosition = 'end',
  download = false,
  external = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  download={download ? '' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  type={href ? undefined : 'button'}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={size === 'lg' ? 19 : 17} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={size === 'lg' ? 19 : 17} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .btn:active { transform: translateY(1px); }

  .btn--md {
    padding: 0.72rem 1.25rem;
    font-size: var(--t-sm);
  }
  .btn--lg {
    padding: 0.92rem 1.6rem;
    font-size: 0.95rem;
  }

  .btn--solid {
    background: var(--btn-bg);
    color: var(--btn-ink);
  }
  .btn--solid:hover { background: var(--btn-bg-hover); }

  .btn--outline {
    border: 1px solid var(--line-ink-strong);
    color: var(--ink);
  }
  .btn--outline:hover {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .btn--ghost {
    color: var(--ink);
    padding-inline: 0.75rem;
  }
  .btn--ghost:hover { background: rgba(11, 53, 48, 0.07); }

  .btn :global(svg) { flex: none; }
</style>

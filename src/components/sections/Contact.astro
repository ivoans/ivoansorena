---
import { SITE } from '../../config';
import { useTranslations } from '../../i18n';
import Button from '../ui/Button.astro';
import Footer from '../Footer.astro';

const t = useTranslations(Astro.currentLocale);
---

<footer class="contact" id={t.contact.id}>
  <div class="container container--wide">
    <div class="contact__card">
      <h2 class="contact__title">{t.contact.title}</h2>
      <p class="contact__body">{t.contact.body}</p>

      <p class="contact__email">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <Button
          variant="ghost"
          icon="copy"
          iconPosition="start"
          class="contact__copy"
          hidden
          data-copy-email={SITE.email}
          data-label-copied={t.contact.copied}
          data-label-failed={t.contact.copyFailed}
        >
          <span data-copy-label aria-live="polite">{t.contact.copy}</span>
        </Button>
      </p>

      <div class="contact__actions">
        <Button href={`mailto:${SITE.email}`} size="lg" icon="mail" iconPosition="start">
          {t.contact.mail}
        </Button>
        <Button href={SITE.linkedin} external variant="outline" size="lg" icon="linkedin" iconPosition="start">
          {t.contact.linkedin}
        </Button>
        <Button href={SITE.github} external variant="outline" size="lg" icon="github" iconPosition="start">
          {t.contact.github}
        </Button>
        <Button href={SITE.cv} download variant="outline" size="lg" icon="download" iconPosition="start">
          {t.contact.cv}
        </Button>
      </div>

      <Footer />
    </div>
  </div>
</footer>

<script>
  const LABEL_RESET_MS = 2000;

  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');

  // Without the Clipboard API (no HTTPS, older browsers) the address stays selectable as text.
  if (button && label && navigator.clipboard) {
    const { copyEmail = '', labelCopied = '', labelFailed = '' } = button.dataset;
    const idleLabel = label.textContent ?? '';
    let resetTimer: number | undefined;

    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyEmail);
        label.textContent = labelCopied;
      } catch {
        label.textContent = labelFailed;
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = idleLabel;
      }, LABEL_RESET_MS);
    });
  }
</script>

<style>
  .contact {
    padding-block: clamp(2rem, 4vw, 4rem) clamp(1rem, 2vw, 2rem);
  }

  .contact__card {
    padding: clamp(2rem, 4.5vw, 4.5rem) clamp(1.4rem, 3.5vw, 3.5rem) clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .contact__title {
    font-size: var(--t-display);
    font-weight: 250;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: 14ch;
  }

  .contact__body {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 52ch;
    font-size: var(--t-lead);
    color: var(--ink-soft);
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: clamp(1rem, 2vw, 1.25rem);
  }

  .contact__email a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--t-h4);
    text-underline-offset: 0.2em;
  }

  /* Button sets its own display, which would otherwise beat the hidden attribute. */
  .contact__copy[hidden] {
    display: none;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }
</style>

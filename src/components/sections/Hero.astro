---
import { SITE, ANCHORS } from '../../config';
import { useTranslations } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import StatCard from '../ui/StatCard.astro';

const t = useTranslations(Astro.currentLocale);
---

<section class="hero" id={ANCHORS.inicio}>
  <div class="container container--wide">
    <div class="hero__intro">
      <p class="hero__role">{t.hero.role}</p>
      <h1 class="hero__name">{t.hero.name}</h1>
      <p class="hero__lead">{t.hero.lead}</p>

      <div class="hero__actions">
        <Button href={`#${ANCHORS.proyectos}`} size="lg" icon="arrowDown">
          {t.hero.ctaProjects}
        </Button>
        <Button href={SITE.cv} download variant="outline" size="lg" icon="download">
          {t.hero.ctaCv}
        </Button>

        <div class="hero__socials">
          <a href={SITE.github} target="_blank" rel="noopener noreferrer me" aria-label={t.contact.github}>
            <Icon name="github" size={19} />
          </a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer me" aria-label={t.contact.linkedin}>
            <Icon name="linkedin" size={19} />
          </a>
        </div>
      </div>

      <div class="hero__meta">
        <p class="hero__stack">
          <span class="hero__stack-label">{t.hero.stackLabel}</span>
          <span class="hero__stack-list">{t.hero.stack.join(' · ')}</span>
        </p>
        <p class="hero__location">
          <Icon name="pin" size={16} />
          <span>{t.hero.location} · {t.hero.availability}</span>
        </p>
      </div>
    </div>

    <ul class="hero__stats">
      {
        t.hero.stats.map((stat, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <StatCard eyebrow={stat.eyebrow} value={stat.value} caption={stat.caption} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 1rem + 9vw, 7rem) clamp(3.5rem, 2rem + 6vw, 6.5rem);
  }

  .hero__intro {
    max-width: 23ch;
  }

  .hero__role {
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .hero__name {
    font-size: var(--t-display);
    font-weight: 250;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero__lead {
    max-width: 54ch;
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    font-size: var(--t-lead);
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: none;
  }

  .hero__socials {
    display: flex;
    gap: 0.25rem;
  }

  .hero__socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  .hero__socials a:hover {
    color: var(--ink);
    background: rgba(11, 53, 48, 0.07);
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
    border-top: 1px solid var(--line-ink);
    max-width: 60ch;
  }

  .hero__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--t-sm);
  }
  .hero__stack-label {
    color: var(--ink-soft);
  }
  .hero__stack-list {
    font-weight: 500;
  }

  .hero__location {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .hero__location :global(svg) {
    flex: none;
    margin-top: 0.15em;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }
  .hero__stats > li {
    display: flex;
  }
  .hero__stats > li > :global(*) {
    flex: 1;
  }

  @media (min-width: 560px) {
    .hero__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* El nombre ocupa su propio bloque: no queremos que se mezcle con la bajada. */
  @media (min-width: 900px) {
    .hero__intro {
      max-width: none;
    }
    .hero__name {
      max-width: 14ch;
    }
  }
</style>

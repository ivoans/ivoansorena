---
import { useTranslations } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

/** Un único diálogo para toda la página. `<dialog>` ya trae Esc, foco atrapado
 *  y fondo propio: el script solo cambia la imagen y navega entre capturas. */
const t = useTranslations(Astro.currentLocale);
---

<dialog class="lb" data-lb-dialog aria-label={t.media.gallery}>
  <div class="lb__bar">
    <p class="lb__counter" data-lb-counter></p>
    <button type="button" class="lb__btn" data-lb-close aria-label={t.media.close}>
      <Icon name="close" size={20} />
    </button>
  </div>

  <figure class="lb__figure">
    <div class="lb__canvas" data-lb-canvas>
      <div class="lb__error" data-lb-error role="alert" hidden>
        <p>{t.media.loadError}</p>
        <Button variant="outline" data-lb-retry>{t.media.retry}</Button>
      </div>
    </div>
    <figcaption class="lb__caption" data-lb-caption></figcaption>
  </figure>

  <button type="button" class="lb__nav lb__nav--prev" data-lb-prev aria-label={t.media.prev}>
    <Icon name="chevronLeft" size={24} />
  </button>
  <button type="button" class="lb__nav lb__nav--next" data-lb-next aria-label={t.media.next}>
    <Icon name="chevronRight" size={24} />
  </button>
</dialog>

<script is:inline define:vars={{ counterTemplate: t.media.counter }}>
  (() => {
    const dialog = document.querySelector('[data-lb-dialog]');
    const canvas = document.querySelector('[data-lb-canvas]');
    const failure = document.querySelector('[data-lb-error]');
    const closeButton = document.querySelector('[data-lb-close]');
    const caption = document.querySelector('[data-lb-caption]');
    const counter = document.querySelector('[data-lb-counter]');
    const triggers = Array.from(document.querySelectorAll('[data-lb]'));
    if (!dialog || !canvas || !failure || triggers.length === 0) return;

    let index = 0;
    let opener = null;

    const show = (i) => {
      index = (i + triggers.length) % triggers.length;
      const el = triggers[index];
      const width = Number(el.dataset.lbW);
      const height = Number(el.dataset.lbH);

      // A new element per capture: reusing one keeps painting the previous
      // capture, stretched to the new proportions, until the next one arrives.
      const image = new Image(width, height);
      image.alt = el.dataset.lbAlt || '';
      image.className = 'is-loading';
      image.style.setProperty('--lb-width', `${width}px`);
      image.style.setProperty('--lb-ratio', String(width / height));
      image.addEventListener('load', () => image.classList.remove('is-loading'));
      image.addEventListener('error', () => {
        // A capture left behind by navigating must not cover the current one.
        if (!image.isConnected) return;
        image.remove();
        failure.hidden = false;
      });
      image.src = el.dataset.lbSrc;

      failure.hidden = true;
      canvas.replaceChildren(failure, image);

      if (caption) caption.textContent = el.dataset.lbAlt || '';
      if (counter) {
        counter.textContent = counterTemplate
          .replace('{n}', String(index + 1))
          .replace('{total}', String(triggers.length));
      }
    };

    triggers.forEach((el, i) => {
      el.addEventListener('click', () => {
        opener = el;
        show(i);
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());
    document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    document.querySelector('[data-lb-retry]')?.addEventListener('click', () => {
      // The button is about to hide, and the focus would fall out of the dialog with it.
      closeButton?.focus();
      show(index);
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
    });

    // Clic fuera de la figura cierra.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // <dialog> restores focus by itself, except in Safari: clicking a button
    // there doesn't focus it, so there's nothing to restore. Without scrolling,
    // like the native restore: the page is where the visitor left it.
    dialog.addEventListener('close', () => {
      canvas.replaceChildren(failure);
      opener?.focus({ preventScroll: true });
    });
  })();
</script>

<style>
  /* Locks the page behind the dialog. On the body so it reaches the viewport:
     on <html>, the body (overflow-x: hidden) would become the scroll container
     and unstick the header. */
  :global(body:has(.lb[open])) {
    overflow: hidden;
  }

  .lb {
    /* Leaves room for the side buttons, which sit half outside the dialog. */
    width: min(100% - 4rem, 1400px);
    max-width: none;
    max-height: 94dvh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--ink);
    overflow: visible;
  }
  .lb::backdrop {
    background: rgba(8, 26, 24, 0.72);
    backdrop-filter: blur(3px);
  }
  .lb:not([open]) {
    display: none;
  }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.6rem 0.6rem 1.1rem;
    border-bottom: 1px solid var(--line-ink);
  }

  .lb__counter {
    font-size: var(--t-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .lb__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    color: var(--ink);
  }
  .lb__btn:hover {
    background: rgba(11, 53, 48, 0.08);
  }

  .lb__figure {
    margin: 0;
    padding: 0.9rem;
  }

  .lb__canvas {
    display: grid;
    place-items: center;
  }

  /* Sized from the capture's data, not from the file, so the box is already
     right while the image loads. The limits: the dialog's width, the file's own
     width, and the height left by the bar and the caption. */
  .lb__canvas :global(img) {
    margin-inline: auto;
    width: min(100%, var(--lb-width), (94dvh - 9rem) * var(--lb-ratio));
    height: auto;
    border-radius: var(--r-sm);
    background: var(--surface);
  }
  .lb__canvas :global(img.is-loading) {
    animation: lb-pulse var(--dur-pulse) ease-in-out infinite alternate;
  }
  @keyframes lb-pulse {
    to {
      background-color: var(--bg-alt);
    }
  }

  .lb__error:not([hidden]) {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    width: 100%;
    min-height: min(60dvh, 24rem);
    margin-block: auto;
    padding: 1.5rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: var(--t-sm);
    text-align: center;
  }

  .lb__caption {
    padding-top: 0.75rem;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .lb__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--btn-ink);
    box-shadow: var(--shadow-md);
  }
  .lb__nav:hover {
    background: var(--btn-bg-hover);
  }
  .lb__nav--prev { left: -23px; }
  .lb__nav--next { right: -23px; }

  @media (max-width: 760px) {
    .lb {
      width: 100%;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
    }
    .lb__figure {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      align-content: center;
      height: calc(100dvh - 3.6rem);
    }

    /* En el celular la captura entra a lo ancho y, si es más alta que la
       pantalla, se desplaza en vertical. Para leer detalles queda el zoom con
       dos dedos del navegador. El margen automático la centra sin cortarle
       la parte de arriba cuando desborda, cosa que `place-items: center` sí hace. */
    .lb__canvas {
      overflow-y: auto;
      overscroll-behavior: contain;
      place-items: start center;
    }
    .lb__canvas :global(img) {
      width: 100%;
      margin: auto;
      border-radius: 0;
    }
    .lb__nav--prev { left: 10px; }
    .lb__nav--next { right: 10px; }
  }
</style>
